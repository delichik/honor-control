<Window x:Class="HonorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid x:Name="AppRoot">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,148,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F8;" FontSize="16" VerticalAlignment="Center" Margin="4,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="荣耀控制中心" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="电源与性能" Opacity="0.62" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" />
                <Button Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
                <ToggleSwitch x:Name="ThemeSwitch" OffContent="浅色" OnContent="深色" Toggled="ThemeSwitch_Toggled" />
            </StackPanel>
        </Grid>

        <controls:NavigationView x:Name="NavigationHost" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                                 PaneDisplayMode="Auto" CompactModeThresholdWidth="700" ExpandedModeThresholdWidth="900"
                                 PaneTitle="控制中心"
                                 SelectionChanged="NavigationView_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="OverviewNavigationItem" Content="概览" Tag="overview" IsSelected="True"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem Content="诊断" Tag="diagnostics"><controls:NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="OverviewView">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="OverviewContent" MaxWidth="1180" Padding="32,24,32,36" HorizontalAlignment="Center">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="NarrowState" />
                                    <VisualState x:Name="WideState">
                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="FirstCardColumn.Width" Value="*" /><Setter Target="SecondCardColumn.Width" Value="*" /><Setter Target="SecondCardRow.Height" Value="0" />
                                            <Setter Target="ChargeCard.(Grid.Column)" Value="0" /><Setter Target="ChargeCard.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="PerformanceCard.(Grid.Column)" Value="1" /><Setter Target="PerformanceCard.(Grid.Row)" Value="0" /><Setter Target="PerformanceCard.(Grid.ColumnSpan)" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="设备概览" Style="{StaticResource TitleTextBlockStyle}" />
                                        <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.78" TextWrapping="Wrap" />
                                        <TextBlock Text="设置仅在本次操作中下发；荣耀电脑管家或 BIOS 策略可能在重启、插拔电源后覆盖。" Opacity="0.62" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="14,10" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding PowerSummary}" Style="{StaticResource BodyStrongTextBlockStyle}" /></Border>
                                </Grid>
                            </Border>

                            <controls:InfoBar x:Name="ConnectionAlert" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="{Binding ConnectionSeverity}" Title="{Binding ConnectionTitle}" Message="{Binding DeviceSummary}" />

                            <Grid x:Name="ControlCardsGrid" Grid.Row="4" RowSpacing="20" ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="FirstCardColumn" Width="*" /><ColumnDefinition x:Name="SecondCardColumn" Width="0" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SecondCardRow" Height="Auto" /></Grid.RowDefinitions>

                                <Border x:Name="ChargeCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="5"><TextBlock Text="智能充电" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding ChargeStatus}" TextWrapping="Wrap" Opacity="0.78" /></StackPanel>
                                        <TextBlock Text="{Binding ChargeAvailabilityText}" TextWrapping="Wrap" Opacity="0.68" />
                                        <StackPanel Spacing="10"><Button Content="电池保护  ·  40%–70%" Style="{StaticResource AccentButtonStyle}" Click="EnableSmartCharge_Click" IsEnabled="{Binding CanConfigureCharge}" HorizontalAlignment="Stretch" /><Button Content="充满模式  ·  0%–100%" Click="DisableSmartCharge_Click" IsEnabled="{Binding CanConfigureCharge}" HorizontalAlignment="Stretch" /></StackPanel>
                                        <controls:Expander Header="高级阈值设置" IsEnabled="{Binding CanConfigureCharge}">
                                            <StackPanel Spacing="12" Margin="0,12,0,0"><TextBlock Text="仅在你明确知道设备策略时使用。开始值不得大于停止值，且均须在 0–100 之间。" TextWrapping="Wrap" Opacity="0.68" /><TextBox Header="开始充电 (%)" Text="{Binding CustomChargeStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBox Header="停止充电 (%)" Text="{Binding CustomChargeEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><Button Content="应用自定义值" Click="ApplyCustomCharge_Click" IsEnabled="{Binding CanConfigureCharge}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CustomChargeValidation}" TextWrapping="Wrap" Opacity="0.68" /></StackPanel>
                                        </controls:Expander>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="PerformanceCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="5"><TextBlock Text="性能模式" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding PerformanceRequirementText}" TextWrapping="Wrap" Opacity="0.72" /></StackPanel>
                                        <controls:RadioButtons x:Name="PerformanceModeSelector" Header="选择待应用的模式" SelectedIndex="0" SelectionChanged="PerformanceModeSelector_SelectionChanged" IsEnabled="{Binding CanConfigurePerformance}"><controls:RadioButton Tag="1" Content="智能模式 — 适合日常办公与轻负载，平衡响应、噪声和续航。" /><controls:RadioButton Tag="2" Content="高能模式 — 适合编译、渲染和游戏；功耗、温度和风扇噪声会提高。" IsEnabled="{Binding CanSelectHighPerformance}" /></controls:RadioButtons>
                                        <Border Padding="16" CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{Binding PendingChangeTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{Binding PendingChangeDetail}" TextWrapping="Wrap" Opacity="0.70" /></StackPanel><Button Grid.Column="1" Content="确认并应用" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="ApplyPerformanceMode_Click" IsEnabled="{Binding CanApplyPerformance}" /></Grid></Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="DiagnosticsView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="980" Padding="32,24,32,36" HorizontalAlignment="Center" Spacing="18">
                            <StackPanel Spacing="6"><TextBlock Text="诊断" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="这里保留原始 WMI 返回和本次会话记录，用于排障；日常使用无需处理这些信息。" Opacity="0.72" TextWrapping="Wrap" /></StackPanel>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="当前诊断" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="复制诊断" Click="CopyDiagnostics_Click" /></Grid><TextBox Text="{Binding DiagnosticDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" /></StackPanel></Border>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="12"><TextBlock Text="本次会话操作" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView ItemsSource="{Binding ActivityRecords}" SelectionMode="None" MaxHeight="320"><ListView.ItemTemplate><DataTemplate><Grid Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayTime}" Opacity="0.62" /><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <controls:InfoBar x:Name="OperationAlert" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="24" IsOpen="False" IsClosable="False" Severity="{Binding OperationSeverity}" Title="{Binding OperationTitle}" Message="{Binding OperationStatus}" />
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
