<Window x:Class="HonorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid x:Name="AppRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowLayout" />
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChargeSecondColumn.Width" Value="*" />
                        <Setter Target="ChargeThirdColumn.Width" Value="*" />
                        <Setter Target="ChargeSecondRow.Height" Value="0" />
                        <Setter Target="ChargeThirdRow.Height" Value="0" />
                        <Setter Target="ChargeProtectOption.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ChargeFullOption.(Grid.Row)" Value="0" />
                        <Setter Target="ChargeFullOption.(Grid.Column)" Value="1" />
                        <Setter Target="ChargeFullOption.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ChargeCustomOption.(Grid.Row)" Value="0" />
                        <Setter Target="ChargeCustomOption.(Grid.Column)" Value="2" />
                        <Setter Target="ChargeCustomOption.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="PerformanceSecondColumn.Width" Value="*" />
                        <Setter Target="PerformanceSecondRow.Height" Value="0" />
                        <Setter Target="SmartPerformanceOption.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HighPerformanceOption.(Grid.Row)" Value="0" />
                        <Setter Target="HighPerformanceOption.(Grid.Column)" Value="1" />
                        <Setter Target="HighPerformanceOption.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="Honor Control" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <controls:NavigationView x:Name="NavigationHost"
                                 Grid.Row="1"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="True"
                                 PaneDisplayMode="Auto"
                                 OpenPaneLength="220"
                                 CompactPaneLength="48"
                                 CompactModeThresholdWidth="720"
                                 ExpandedModeThresholdWidth="980"
                                 SelectionChanged="NavigationView_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="ChargeNavigationItem" Content="智能充电" Tag="charge" IsSelected="True">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE85B;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="PerformanceNavigationItem" Content="性能模式" Tag="performance">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="ChargeView">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel MaxWidth="960" Padding="32,28,32,40" HorizontalAlignment="Stretch" Spacing="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="智能充电" Style="{StaticResource PageTitleTextStyle}" />
                                    <TextBlock Text="选择适合当前使用场景的充电上限。" Style="{StaticResource PageSubtitleTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}" ToolTipService.ToolTip="刷新状态">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource AppCardStyle}" MinHeight="112">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StatusIconContainerStyle}">
                                        <FontIcon Glyph="&#xE85B;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="当前充电策略" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding ChargeStatus}" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ChargeAvailabilityText}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="充电模式" Style="{StaticResource SectionTitleTextStyle}" />
                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="ChargeSecondColumn" Width="0" />
                                            <ColumnDefinition x:Name="ChargeThirdColumn" Width="0" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition x:Name="ChargeSecondRow" Height="Auto" />
                                            <RowDefinition x:Name="ChargeThirdRow" Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <RadioButton x:Name="ChargeProtectOption" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" GroupName="ChargeMode" Tag="1" Style="{StaticResource OptionRadioButtonStyle}" IsEnabled="{Binding CanConfigureCharge}" Checked="ChargeModeOption_Checked">
                                            <StackPanel Spacing="6">
                                                <FontIcon Glyph="&#xE83D;" FontSize="22" HorizontalAlignment="Left" />
                                                <TextBlock Text="电池保护" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="40%–70% · 适合长期接通电源" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ChargeFullOption" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" GroupName="ChargeMode" Tag="2" Style="{StaticResource OptionRadioButtonStyle}" IsEnabled="{Binding CanConfigureCharge}" Checked="ChargeModeOption_Checked">
                                            <StackPanel Spacing="6">
                                                <FontIcon Glyph="&#xE83F;" FontSize="22" HorizontalAlignment="Left" />
                                                <TextBlock Text="完整续航" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="0%–100% · 适合外出前充满" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ChargeCustomOption" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" GroupName="ChargeMode" Tag="0" Style="{StaticResource OptionRadioButtonStyle}" IsEnabled="{Binding CanConfigureCharge}" Checked="ChargeModeOption_Checked">
                                            <StackPanel Spacing="6">
                                                <FontIcon Glyph="&#xE713;" FontSize="22" HorizontalAlignment="Left" />
                                                <TextBlock Text="自定义" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="设置恢复与停止充电阈值" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <Grid x:Name="CustomChargeEditor" Visibility="Collapsed" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="CustomChargeStartBox" Header="恢复充电" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="CustomChargeNumberBox_ValueChanged" />
                                        <NumberBox x:Name="CustomChargeEndBox" Grid.Column="1" Header="停止充电" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="CustomChargeNumberBox_ValueChanged" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ChargeModeHint}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding ChargeActionLabel}" Style="{StaticResource PrimaryActionButtonStyle}" Click="ApplySelectedChargeMode_Click" IsEnabled="{Binding CanApplySelectedChargeMode}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PerformanceView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel MaxWidth="960" Padding="32,28,32,40" HorizontalAlignment="Stretch" Spacing="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="性能模式" Style="{StaticResource PageTitleTextStyle}" />
                                    <TextBlock Text="在安静、续航和性能之间快速切换。" Style="{StaticResource PageSubtitleTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}" ToolTipService.ToolTip="刷新状态">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>

                            <Border Style="{StaticResource AppCardStyle}" MinHeight="112">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StatusIconContainerStyle}">
                                        <FontIcon Glyph="&#xE945;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="切换条件" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding PerformanceRequirementText}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="12,7" CornerRadius="16" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PowerSummary}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppCardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="选择模式" Style="{StaticResource SectionTitleTextStyle}" />
                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="PerformanceSecondColumn" Width="0" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition x:Name="PerformanceSecondRow" Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <RadioButton x:Name="SmartPerformanceOption" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" GroupName="PerformanceMode" Tag="1" IsChecked="True" Style="{StaticResource OptionRadioButtonStyle}" IsEnabled="{Binding CanConfigurePerformance}" Checked="PerformanceModeOption_Checked">
                                            <StackPanel Spacing="6">
                                                <FontIcon Glyph="&#xE9CA;" FontSize="22" HorizontalAlignment="Left" />
                                                <TextBlock Text="智能" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="日常办公与轻负载" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="HighPerformanceOption" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" GroupName="PerformanceMode" Tag="2" Style="{StaticResource OptionRadioButtonStyle}" IsEnabled="{Binding CanSelectHighPerformance}" Checked="PerformanceModeOption_Checked">
                                            <StackPanel Spacing="6">
                                                <FontIcon Glyph="&#xE945;" FontSize="22" HorizontalAlignment="Left" />
                                                <TextBlock Text="高能" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="编译、渲染与游戏" Style="{StaticResource SecondaryTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="实验性控制" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="设备会接收模式请求，但当前状态无法可靠回读。" Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="应用性能模式" Style="{StaticResource PrimaryActionButtonStyle}" Click="ApplyPerformanceMode_Click" IsEnabled="{Binding CanApplyPerformance}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel MaxWidth="960" Padding="32,28,32,40" HorizontalAlignment="Stretch" Spacing="16">
                            <StackPanel Spacing="4" Margin="0,0,0,4">
                                <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />
                                <TextBlock Text="调整应用外观和后台行为。" Style="{StaticResource PageSubtitleTextStyle}" />
                            </StackPanel>

                            <TextBlock Text="常规" Style="{StaticResource SectionTitleTextStyle}" Margin="0,8,0,0" />
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="关闭窗口时驻留托盘" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="从托盘菜单可以重新打开或完全退出。" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="2" Toggled="CloseToTrayToggle_Toggled" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="应用主题" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="ThemeSettingsHint" Text="颜色会立即应用。" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeSelector" Grid.Column="2" MinWidth="150" SelectionChanged="ThemeSelector_SelectionChanged" VerticalAlignment="Center">
                                        <ComboBoxItem Tag="System">跟随系统</ComboBoxItem>
                                        <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                                        <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <TextBlock Text="支持" Style="{StaticResource SectionTitleTextStyle}" Margin="0,12,0,0" />
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Repair" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="故障排查" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="查看或复制硬件接口诊断信息。" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="查看诊断" Click="ShowDiagnostics_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TraySettingsHint" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <controls:InfoBar x:Name="ConnectionAlert" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="896" Margin="32,16,32,0" IsOpen="False" IsClosable="True" Severity="{Binding ConnectionSeverity}" Title="{Binding ConnectionTitle}" Message="{Binding DeviceSummary}" />
                <controls:InfoBar x:Name="OperationAlert" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="896" Margin="32,0,32,24" IsOpen="False" IsClosable="True" Severity="{Binding OperationSeverity}" Title="{Binding OperationTitle}" Message="{Binding OperationStatus}" />
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
