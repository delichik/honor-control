<Window x:Class="HonorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid x:Name="AppRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F8;" FontSize="16" VerticalAlignment="Center" Margin="4,0,12,0" />
            <TextBlock Grid.Column="1" Text="荣耀控制中心" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <controls:NavigationView x:Name="NavigationHost"
                                 Grid.Row="1"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="True"
                                 PaneDisplayMode="Auto"
                                 CompactModeThresholdWidth="700"
                                 ExpandedModeThresholdWidth="900"
                                 SelectionChanged="NavigationView_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="OverviewNavigationItem" Content="概览" Tag="overview" IsSelected="True">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="ChargeNavigationItem" Content="智能充电" Tag="charge">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE85B;" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="PerformanceNavigationItem" Content="性能模式" Tag="performance">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="诊断" Tag="diagnostics">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <Grid>
                <Grid x:Name="OverviewView">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="OverviewContent" MaxWidth="1120" Padding="32,24,32,36" HorizontalAlignment="Center">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="OverviewNarrow" />
                                    <VisualState x:Name="OverviewWide">
                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="OverviewLinkSecondColumn.Width" Value="*" />
                                            <Setter Target="OverviewLinkSecondRow.Height" Value="0" />
                                            <Setter Target="ChargeEntry.(Grid.Column)" Value="0" />
                                            <Setter Target="ChargeEntry.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="PerformanceEntry.(Grid.Column)" Value="1" />
                                            <Setter Target="PerformanceEntry.(Grid.Row)" Value="0" />
                                            <Setter Target="PerformanceEntry.(Grid.ColumnSpan)" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="设备状态与常用控制入口" Opacity="0.70" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="刷新状态" /></StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="2" Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding ConnectionTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="{Binding DeviceSummary}" TextWrapping="Wrap" Opacity="0.78" />
                                        <TextBlock Text="设置仅在本次操作中下发；荣耀电脑管家或 BIOS 策略可能在重启、插拔电源后覆盖。" TextWrapping="Wrap" Opacity="0.62" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="14,10" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PowerSummary}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4" RowSpacing="18" ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="OverviewLinkSecondColumn" Width="0" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="OverviewLinkSecondRow" Height="Auto" /></Grid.RowDefinitions>
                                <Button x:Name="ChargeEntry" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="20" HorizontalContentAlignment="Left" Click="OpenCharge_Click">
                                    <StackPanel Spacing="6"><TextBlock Text="智能充电" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding ChargeStatus}" TextWrapping="Wrap" Opacity="0.72" /><TextBlock Text="打开充电策略" Opacity="0.62" /></StackPanel>
                                </Button>
                                <Button x:Name="PerformanceEntry" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="20" HorizontalContentAlignment="Left" Click="OpenPerformance_Click">
                                    <StackPanel Spacing="6"><TextBlock Text="性能模式" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding PerformanceRequirementText}" TextWrapping="Wrap" Opacity="0.72" /><TextBlock Text="打开性能控制" Opacity="0.62" /></StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ChargeView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="860" Padding="32,24,32,36" HorizontalAlignment="Center" Spacing="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6"><TextBlock Text="智能充电" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="选择策略后再应用；写入会由 BIOS 回读验证。" Opacity="0.70" /></StackPanel>
                                <Button Grid.Column="1" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="刷新状态" /></StackPanel></Button>
                            </Grid>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8"><TextBlock Text="当前策略" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding ChargeStatus}" TextWrapping="Wrap" /><TextBlock Text="{Binding ChargeAvailabilityText}" TextWrapping="Wrap" Opacity="0.68" /></StackPanel>
                            </Border>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="预设策略" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <controls:RadioButtons x:Name="ChargeModeSelector" SelectedIndex="{Binding SelectedChargePresetIndex, Mode=TwoWay}" SelectionChanged="ChargeModeSelector_SelectionChanged" IsEnabled="{Binding CanConfigureCharge}">
                                        <controls:RadioButton><Border Padding="14" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="电池保护 · 40%–70%" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="适合长期接通电源使用，减少满电停留。" TextWrapping="Wrap" Opacity="0.70" /></StackPanel></Border></controls:RadioButton>
                                        <controls:RadioButton><Border Padding="14" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="充满模式 · 0%–100%" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="适合即将移动使用，需要完整续航时。" TextWrapping="Wrap" Opacity="0.70" /></StackPanel></Border></controls:RadioButton>
                                    </controls:RadioButtons>
                                    <Border Padding="14" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <StackPanel Spacing="4"><TextBlock Text="{Binding SelectedChargePresetLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{Binding SelectedChargePresetDetail}" TextWrapping="Wrap" Opacity="0.70" /></StackPanel>
                                    </Border>
                                    <Button Content="应用所选策略" Style="{StaticResource AccentButtonStyle}" Click="ApplySelectedChargePreset_Click" IsEnabled="{Binding CanApplySelectedChargePreset}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <controls:Expander Header="高级自定义阈值" IsEnabled="{Binding CanConfigureCharge}">
                                <StackPanel Spacing="12" Margin="0,12,0,0"><TextBlock Text="仅在你明确知道设备策略时使用。开始值不得大于停止值，且均须在 0–100 之间。" TextWrapping="Wrap" Opacity="0.68" /><TextBox Header="开始充电 (%)" Text="{Binding CustomChargeStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBox Header="停止充电 (%)" Text="{Binding CustomChargeEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="{Binding CustomChargeValidation}" TextWrapping="Wrap" Opacity="0.68" /><Button Content="应用自定义值" Click="ApplyCustomCharge_Click" IsEnabled="{Binding CanConfigureCharge}" HorizontalAlignment="Left" /></StackPanel>
                            </controls:Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PerformanceView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="860" Padding="32,24,32,36" HorizontalAlignment="Center" Spacing="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6"><TextBlock Text="性能模式" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="仅在满足供电前置条件时开放写入。" Opacity="0.70" /></StackPanel>
                                <Button Grid.Column="1" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="刷新状态" /></StackPanel></Button>
                            </Grid>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="8"><TextBlock Text="供电与能力预检" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="{Binding PowerSummary}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{Binding PerformanceRequirementText}" TextWrapping="Wrap" Opacity="0.72" /></StackPanel>
                            </Border>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="选择待应用的模式" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <controls:RadioButtons x:Name="PerformanceModeSelector" SelectedIndex="0" SelectionChanged="PerformanceModeSelector_SelectionChanged" IsEnabled="{Binding CanConfigurePerformance}">
                                        <controls:RadioButton Tag="1"><Border Padding="14" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="智能模式" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="适合日常办公与轻负载，平衡响应、噪声和续航。" TextWrapping="Wrap" Opacity="0.70" /></StackPanel></Border></controls:RadioButton>
                                        <controls:RadioButton Tag="2" IsEnabled="{Binding CanSelectHighPerformance}"><Border Padding="14" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="高能模式" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="适合编译、渲染和游戏；功耗、温度和风扇噪声会提高。" TextWrapping="Wrap" Opacity="0.70" /></StackPanel></Border></controls:RadioButton>
                                    </controls:RadioButtons>
                                    <Border Padding="14" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <StackPanel Spacing="4"><TextBlock Text="{Binding PendingChangeTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{Binding PendingChangeDetail}" TextWrapping="Wrap" Opacity="0.70" /></StackPanel>
                                    </Border>
                                    <Button Content="确认并应用" Style="{StaticResource AccentButtonStyle}" Click="ApplyPerformanceMode_Click" IsEnabled="{Binding CanApplyPerformance}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="DiagnosticsView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="980" Padding="32,24,32,36" HorizontalAlignment="Center" Spacing="18">
                            <StackPanel Spacing="6"><TextBlock Text="诊断" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="原始 WMI 返回与本次会话记录仅用于排障。" Opacity="0.72" TextWrapping="Wrap" /></StackPanel>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="当前诊断" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="复制诊断" Click="CopyDiagnostics_Click" /></Grid><TextBox Text="{Binding DiagnosticDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" /></StackPanel>
                            </Border>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12"><TextBlock Text="本次会话操作" Style="{StaticResource SubtitleTextBlockStyle}" /><ListView ItemsSource="{Binding ActivityRecords}" SelectionMode="None" MaxHeight="320"><ListView.ItemTemplate><DataTemplate><Grid Padding="4"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayTime}" Opacity="0.62" /><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="760" Padding="32,24,32,36" HorizontalAlignment="Center" Spacing="18">
                            <StackPanel Spacing="6"><TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="外观偏好仅保存在此电脑的当前用户配置中。" Opacity="0.72" TextWrapping="Wrap" /></StackPanel>
                            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="12"><TextBlock Text="应用主题" Style="{StaticResource SubtitleTextBlockStyle}" /><ComboBox x:Name="ThemeSelector" Header="主题" SelectionChanged="ThemeSelector_SelectionChanged"><ComboBoxItem Tag="System">跟随系统</ComboBoxItem><ComboBoxItem Tag="Light">浅色</ComboBoxItem><ComboBoxItem Tag="Dark">深色</ComboBoxItem></ComboBox><TextBlock x:Name="ThemeSettingsHint" Text="选择后立即应用。" Opacity="0.68" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <controls:InfoBar x:Name="ConnectionAlert" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="24,16,24,0" IsOpen="False" IsClosable="False" Severity="{Binding ConnectionSeverity}" Title="{Binding ConnectionTitle}" Message="{Binding DeviceSummary}" />
                <controls:InfoBar x:Name="OperationAlert" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="24" IsOpen="False" IsClosable="False" Severity="{Binding OperationSeverity}" Title="{Binding OperationTitle}" Message="{Binding OperationStatus}" />
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
