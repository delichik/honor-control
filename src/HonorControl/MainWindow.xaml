<Window x:Class="HonorControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="RootGrid" Padding="32,26,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MaxWidth="920" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="荣耀控制中心" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="清晰、可验证地管理电池保护和性能表现" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.72" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="ThemeSwitch" OffContent="浅色" OnContent="深色" Toggled="ThemeSwitch_Toggled" />
                        <Button Content="刷新状态" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>
                </Grid>

                <controls:InfoBar Grid.Row="2" IsOpen="True" IsClosable="False" Severity="{Binding ConnectionSeverity}"
                                  Title="{Binding ConnectionTitle}" Message="{Binding DeviceSummary}" />

                <Border Grid.Row="4" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="智能充电" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding ChargeStatus}" TextWrapping="Wrap" Opacity="0.78" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PowerSummary}" VerticalAlignment="Center" Opacity="0.72" />
                        </Grid>

                        <controls:InfoBar IsOpen="True" IsClosable="False" Severity="{Binding ChargeAvailabilitySeverity}" Message="{Binding ChargeAvailabilityText}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="电池保护  ·  40%–70%" Style="{StaticResource AccentButtonStyle}" Click="EnableSmartCharge_Click" IsEnabled="{Binding CanConfigureCharge}" />
                            <Button Grid.Column="1" Content="充满模式  ·  0%–100%" Click="DisableSmartCharge_Click" IsEnabled="{Binding CanConfigureCharge}" />
                        </Grid>

                        <controls:Expander Header="高级阈值设置" IsEnabled="{Binding CanConfigureCharge}">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Text="仅在你明确知道设备策略时使用。开始值不得大于停止值，且均须在 0–100 之间。" TextWrapping="Wrap" Opacity="0.72" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="开始" Text="{Binding CustomChargeStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                                    <TextBox Grid.Column="2" Header="停止" Text="{Binding CustomChargeEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Text="%" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                                    <Button Grid.Column="4" Content="应用自定义值" VerticalAlignment="Bottom" Click="ApplyCustomCharge_Click" IsEnabled="{Binding CanConfigureCharge}" />
                                </Grid>
                                <controls:InfoBar IsOpen="True" IsClosable="False" Severity="{Binding CustomChargeValidationSeverity}" Message="{Binding CustomChargeValidation}" />
                            </StackPanel>
                        </controls:Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="性能模式" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <controls:InfoBar IsOpen="True" IsClosable="False" Severity="{Binding PerformanceRequirementSeverity}" Message="{Binding PerformanceRequirementText}" />
                        <controls:RadioButtons x:Name="PerformanceModeSelector" Header="选择待应用的模式" SelectedIndex="0" SelectionChanged="PerformanceModeSelector_SelectionChanged" IsEnabled="{Binding CanConfigurePerformance}">
                            <controls:RadioButton Tag="1" Content="智能模式 — 适合日常办公与轻负载，平衡响应、噪声和续航。" />
                            <controls:RadioButton Tag="2" Content="高能模式 — 适合编译、渲染和游戏；功耗、温度和风扇噪声会提高。" IsEnabled="{Binding CanSelectHighPerformance}" />
                        </controls:RadioButtons>
                        <Border Padding="16" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding PendingChangeTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding PendingChangeDetail}" TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="确认并应用" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Click="ApplyPerformanceMode_Click" IsEnabled="{Binding CanApplyPerformance}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <controls:InfoBar Grid.Row="8" IsOpen="True" IsClosable="False" Severity="{Binding OperationSeverity}"
                                  Title="{Binding OperationTitle}" Message="{Binding OperationStatus}" />

                <controls:Expander Grid.Row="10" Header="诊断详情与本次会话记录" Margin="0,14,0,0">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock Text="{Binding DiagnosticDetails}" TextWrapping="Wrap" Opacity="0.72" />
                        <ListView ItemsSource="{Binding ActivityRecords}" MaxHeight="180" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayTime}" Opacity="0.65" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </controls:Expander>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
