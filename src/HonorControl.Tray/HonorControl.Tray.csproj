<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HonorControl.Tray</AssemblyName>
    <RootNamespace>HonorControl.Tray</RootNamespace>
    <!-- 托盘是普通权限进程：不申请提权，不做任何需要管理员的操作。
         停止服务是"请求服务自己停"，不依赖 SERVICE_STOP 权限。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HonorControl.Contracts\HonorControl.Contracts.csproj" />
  </ItemGroup>
</Project>
